# ===================================================================
# Auth Service (Пример)
# ===================================================================
SERVICE_NAME=auth-service
PORT=8001

# Database
DB_HOST=auth-db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=vuzhub_auth

# JWT
SECRET_JWT_KEY=qwert
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
