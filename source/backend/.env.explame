# =============================================================================
# VuzHub Backend — переменные окружения
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Общие настройки
# -----------------------------------------------------------------------------
# Имя сервиса: monolith | auth-service | study-service | finance-service | integration-service
SERVICE_NAME=monolith

# Порт, на котором слушает uvicorn
PORT=8000

# Режим отладки (true/false). В продакшене ОБЯЗАТЕЛЬНО false
DEBUG=true

# Уровень логирования: debug | info | warning | error | critical
LOG_LEVEL=info

# Заголовок приложения в OpenAPI/Swagger
APP_TITLE=VuzHub API

# Версия приложения
APP_VERSION=0.1.0

# -----------------------------------------------------------------------------
# База данных (PostgreSQL + asyncpg)
# -----------------------------------------------------------------------------
# Формат: postgresql+asyncpg://user:password@host:port/dbname
# Для Docker: host = db (имя контейнера из docker-compose)
# Для локальной разработки: host = localhost
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vuzhub

# Пул соединений
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# Redis (кэш, сессии, rate-limit)
# -----------------------------------------------------------------------------
# Оставьте закомментированным, если Redis не используется
# REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=
# REDIS_DB=0

# -----------------------------------------------------------------------------
# JWT / Авторизация
# -----------------------------------------------------------------------------
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-use-long-random-string

# Алгоритм подписи JWT
ALGORITHM=HS256

# Время жизни access-токена (в минутах)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Время жизни refresh-токена (в днях)
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# CORS (разрешённые источники для фронтенда)
# -----------------------------------------------------------------------------
# Через запятую, без пробелов
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Интеграции (для integration-service)
# -----------------------------------------------------------------------------
# Внешние API, с которыми работает сервис
# LK_ISU_API_URL=https://isu.example.com/api
# LK_ISU_LOGIN=
# LK_ISU_PASSWORD=

# -----------------------------------------------------------------------------
# S3 / Хранилище файлов (для аватарок, документов)
# -----------------------------------------------------------------------------
# S3_ENDPOINT=https://s3.example.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=vuzhub-files
# S3_REGION=ru-central1

# -----------------------------------------------------------------------------
# Уведомления (email, telegram)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
